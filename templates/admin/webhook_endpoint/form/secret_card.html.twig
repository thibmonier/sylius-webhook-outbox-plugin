{% set endpoint = hookable_metadata.context.resource %}

<div class="container-xl mt-3">
    <div class="card">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="flex-fill">
                <div class="fw-bold">{{ 'tmonier_webhook.ui.signing_secret'|trans }}</div>
                <div class="text-secondary small">{{ 'tmonier_webhook.ui.secret_hidden'|trans }}</div>
            </div>
            <form action="{{ path('tmonier_webhook_admin_webhook_endpoint_regenerate_secret', {'id': endpoint.id}) }}" method="post"
                  onsubmit="return confirm({{ 'tmonier_webhook.ui.regenerate_secret_confirm'|trans|json_encode|e('html_attr') }});">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token(tmonier_webhook_endpoint_token_id(endpoint.id)) }}">
                <button type="submit" class="btn" {{ sylius_test_html_attribute('tmonier-webhook-regenerate-secret') }}>{{ ux_icon('tabler:key', {'class': 'icon'}) }} {{ 'tmonier_webhook.ui.regenerate_secret'|trans }}</button>
            </form>
            <form action="{{ path('tmonier_webhook_admin_webhook_endpoint_ping', {'id': endpoint.id}) }}" method="post">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token(tmonier_webhook_endpoint_token_id(endpoint.id)) }}">
                <button type="submit" class="btn" {{ sylius_test_html_attribute('tmonier-webhook-ping') }}>{{ ux_icon('tabler:radar', {'class': 'icon'}) }} {{ 'tmonier_webhook.ui.ping'|trans }}</button>
            </form>
        </div>
    </div>
</div>
