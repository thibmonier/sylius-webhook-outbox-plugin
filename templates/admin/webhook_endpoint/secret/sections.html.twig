{% set endpoint = hookable_metadata.context.resource %}

<div class="page-body">
    <div class="container-xl">
        <div class="alert alert-warning" role="alert">
            <div class="alert-heading fw-bold">{{ (hookable_metadata.context.created ? 'tmonier_webhook.ui.endpoint_created' : 'tmonier_webhook.ui.secret_regenerated')|trans }}</div>
            <div>{{ 'tmonier_webhook.ui.secret_shown_once'|trans }}</div>
        </div>
        <div class="card">
            <div class="card-body">
                <label class="form-label" for="tmonier-webhook-secret">{{ 'tmonier_webhook.ui.signing_secret'|trans }}</label>
                <div class="input-group">
                    <input id="tmonier-webhook-secret" type="text" class="form-control font-monospace" readonly autocomplete="off" value="{{ hookable_metadata.context.secret }}" {{ sylius_test_html_attribute('tmonier-webhook-secret') }} onfocus="this.select()">
                    <button type="button" class="btn" onclick="navigator.clipboard && navigator.clipboard.writeText(document.getElementById('tmonier-webhook-secret').value)">{{ ux_icon('tabler:copy', {'class': 'icon'}) }} {{ 'tmonier_webhook.ui.copy'|trans }}</button>
                </div>
                <div class="form-hint mt-2">{{ 'tmonier_webhook.ui.secret_usage'|trans }}</div>
            </div>
            <div class="card-footer d-flex gap-2">
                <a href="{{ path('tmonier_webhook_admin_webhook_endpoint_update', {'id': endpoint.id}) }}" class="btn btn-primary">{{ 'tmonier_webhook.ui.secret_copied'|trans }}</a>
                <a href="{{ path('tmonier_webhook_admin_webhook_endpoint_index') }}" class="btn">{{ 'tmonier_webhook.ui.webhook_endpoints'|trans }}</a>
            </div>
        </div>
    </div>
</div>
