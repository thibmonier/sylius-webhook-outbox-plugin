<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusWebhookOutboxPlugin\Entity\WebhookDelivery" table="tmonier_webhook_delivery">
        <indexes>
            <!-- Claim query of the worker. -->
            <index name="tmonier_webhook_delivery_due_idx" columns="status,next_attempt_at,id" />
            <index name="tmonier_webhook_delivery_created_at_idx" columns="created_at" />
        </indexes>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="status" column="status" type="string" length="16" />
        <field name="attempts" column="attempts" type="integer" />
        <field name="nextAttemptAt" column="next_attempt_at" type="datetime_immutable" nullable="true" />
        <field name="lastAttemptAt" column="last_attempt_at" type="datetime_immutable" nullable="true" />
        <field name="deliveredAt" column="delivered_at" type="datetime_immutable" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <field name="lastResponseStatus" column="last_response_status" type="integer" nullable="true" />
        <field name="lastResponseBody" column="last_response_body" type="text" nullable="true" />
        <field name="lastError" column="last_error" type="text" nullable="true" />
        <field name="attemptHistory" column="attempt_history" type="json" />
        <field name="claimedUntil" column="claimed_until" type="datetime_immutable" nullable="true" />
        <field name="claimToken" column="claim_token" type="string" length="64" nullable="true" />
        <field name="replayOf" column="replay_of" type="integer" nullable="true" />

        <many-to-one field="event" target-entity="Tmonier\SyliusWebhookOutboxPlugin\Entity\OutboxEventInterface">
            <join-column name="event_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
        <many-to-one field="endpoint" target-entity="Tmonier\SyliusWebhookOutboxPlugin\Entity\WebhookEndpointInterface">
            <join-column name="endpoint_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
    </mapped-superclass>

</doctrine-mapping>
